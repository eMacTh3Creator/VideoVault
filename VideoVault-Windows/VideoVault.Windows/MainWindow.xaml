<Window x:Class="VideoVault.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VideoVault" Width="1220" Height="800" MinWidth="900" MinHeight="620"
        Style="{StaticResource {x:Type Window}}"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop" PreviewKeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="78" /><RowDefinition Height="*" /><RowDefinition Height="38" /></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="24,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Image Source="/VideoVault.Windows;component/Assets/VideoVault.ico" Width="38" Height="38" Margin="0,0,12,0" />
                    <StackPanel><TextBlock Text="VideoVault" FontSize="23" FontWeight="SemiBold" />
                        <TextBlock Text="YOUR MEDIA. YOUR LIBRARY." FontSize="9" Foreground="{StaticResource MutedBrush}" /></StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="HomeButton" Content="Home" Click="Home_Click" ToolTip="Return home without removing downloads" />
                    <Button Content="Library tools" Click="Duplicates_Click" />
                    <Button Content="Settings" Click="Settings_Click" />
                    <Button Content="+ Add URLs" Style="{StaticResource AccentButton}" Click="AddUrls_Click" ToolTip="Ctrl+N" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="370" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="#F0F4F7" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="18,24,18,14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="Downloads" FontSize="23" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="{Binding Statistics}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,20" />
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search title or URL" AutomationProperties.Name="Search downloads" />
                        <TextBlock Text="Search downloads..." Margin="11,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ComboBox Grid.Row="3" x:Name="FilterCombo" SelectionChanged="Filter_Changed" SelectedIndex="0" Margin="0,0,0,18">
                        <ComboBoxItem Content="All downloads" /><ComboBoxItem Content="Active" /><ComboBoxItem Content="Queued" /><ComboBoxItem Content="Completed / already in library" /><ComboBoxItem Content="Failed" />
                    </ComboBox>
                    <ListBox Grid.Row="4" ItemsSource="{Binding VisibleDownloads}" SelectedItem="{Binding SelectedDownload}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Margin" Value="0,0,0,8" /><Setter Property="Padding" Value="12" /></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid>
                                <Grid.ContextMenu><ContextMenu>
                                    <MenuItem Header="Retry" Click="ItemRetry_Click" IsEnabled="{Binding CanRetry}" />
                                    <MenuItem Header="Force Retry" Click="ItemForce_Click" IsEnabled="{Binding CanRetry}" />
                                    <MenuItem Header="Cancel" Click="ItemCancel_Click" IsEnabled="{Binding IsActive}" />
                                    <Separator /><MenuItem Header="Copy URL" Click="ItemCopy_Click" /><MenuItem Header="Show in Explorer" Click="ItemFolder_Click" />
                                    <MenuItem Header="Remove from queue" Click="ItemRemove_Click" />
                                </ContextMenu></Grid.ContextMenu>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding FormatDisplayName}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,2" />
                                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                    <ProgressBar Height="3" Maximum="1" Value="{Binding Progress}" Margin="0,8,0,0" Visibility="{Binding IsActive, Converter={StaticResource BoolVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Grid.Row="5" Margin="0,14,0,0"><Button Content="Resume queue" Click="Start_Click" /><Button Content="Pause" Click="Pause_Click" /><Button Content="Retry failed" Click="RetryFailed_Click" /></WrapPanel>
                </Grid>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="38,34">
                    <StackPanel Visibility="{Binding IsHome, Converter={StaticResource BoolVisibility}}">
                        <Border Background="#EAF0F5" CornerRadius="14" Padding="28">
                            <StackPanel>
                                <TextBlock Text="A SPACE FOR WHAT YOU SAVE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="Keep the good stuff." FontSize="38" FontWeight="SemiBold" Margin="0,12,0,12" TextWrapping="Wrap" />
                                <TextBlock Text="Video or audio, at the quality you choose. Paste a link and let your library grow." FontSize="16" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="24" />
                                <WrapPanel Margin="0,24,0,0"><Button Content="+ Add a download" Style="{StaticResource AccentButton}" Click="AddUrls_Click" /><Button Content="Paste best video" Click="PasteVideo_Click" /><Button Content="Paste best audio" Click="PasteAudio_Click" /></WrapPanel>
                            </StackPanel>
                        </Border>
                        <UniformGrid Columns="3" Margin="0,24,0,24">
                            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,10,0"><StackPanel><TextBlock Text="{Binding ActiveCount}" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="DOWNLOADING" FontSize="10" Foreground="{StaticResource MutedBrush}" /></StackPanel></Border>
                            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,10,0"><StackPanel><TextBlock Text="{Binding QueuedCount}" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="IN YOUR QUEUE" FontSize="10" Foreground="{StaticResource MutedBrush}" /></StackPanel></Border>
                            <Border Background="White" CornerRadius="10" Padding="20"><StackPanel><TextBlock Text="{Binding CompletedCount}" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="IN YOUR LIBRARY" FontSize="10" Foreground="{StaticResource MutedBrush}" /></StackPanel></Border>
                        </UniformGrid>
                        <TextBlock Text="Made to stay out of your way." FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBlock Text="Downloads run independently. Use the tray icon to paste a link without opening the window. Your queue is saved automatically." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" LineHeight="23" />
                        <WrapPanel Margin="0,22,0,0"><Button Content="Open destination" Click="OpenFolder_Click" /><Button Content="Find duplicates" Click="Duplicates_Click" /></WrapPanel>
                    </StackPanel>
                    <StackPanel DataContext="{Binding SelectedDownload}" Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="{Binding FormatDisplayName}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DisplayTitle}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,8" />
                        <TextBlock Text="{Binding SourceName}" Foreground="{StaticResource MutedBrush}" />
                        <Border Background="White" CornerRadius="12" Padding="24" Margin="0,26,0,20">
                            <StackPanel><TextBlock Text="{Binding StatusText}" FontSize="17" TextWrapping="Wrap" />
                                <ProgressBar Maximum="1" Value="{Binding Progress}" Height="8" Margin="0,16,0,0" Visibility="{Binding IsActive, Converter={StaticResource BoolVisibility}}" />
                                <TextBox Text="{Binding ErrorMessage, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="#B53535" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="DETAILS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" />
                        <TextBox Text="{Binding Url, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,0,0,16" />
                        <TextBlock Text="{Binding FilePath}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="{Binding Downloader, StringFormat=Downloader: {0}}" Margin="0,12,0,0" />
                        <WrapPanel Margin="0,24,0,0"><Button Content="Retry" Click="Retry_Click" IsEnabled="{Binding CanRetry}" /><Button Content="Force Retry" Click="Force_Click" IsEnabled="{Binding CanRetry}" ToolTip="Skip optional metadata and thumbnail, and try the backup downloader. Does not bypass DRM or access restrictions." /><Button Content="Cancel" Click="Cancel_Click" IsEnabled="{Binding IsActive}" /><Button Content="Copy URL" Click="CopyUrl_Click" /><Button Content="Show in Explorer" Click="OpenFolder_Click" /><Button Content="Remove" Click="Remove_Click" /></WrapPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="20,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding ToolStatus}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="{Binding FooterText}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource MutedBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
