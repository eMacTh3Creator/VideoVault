<Window x:Class="VideoVault.Windows.DuplicateFinderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VideoVault Duplicate Finder" Width="850" Height="620" WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}">
    <DockPanel Margin="28">
        <StackPanel DockPanel.Dock="Top"><TextBlock Text="A little room in your library." FontSize="27" FontWeight="SemiBold" /><TextBlock Text="Matches are verified by file size and SHA-256 content, not just the name." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,18" /><TextBlock x:Name="StatusText" Text="Ready to scan" TextWrapping="Wrap" Margin="0,0,0,18" /></StackPanel>
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,20,0,0"><Button x:Name="ScanButton" Content="Scan destination" Style="{StaticResource AccentButton}" Click="Scan_Click" /><Button Content="Cancel scan" Click="Cancel_Click" /><Button Content="Show selected file" Click="Open_Click" /><Button Content="Recycle selected duplicate" Click="Recycle_Click" /></WrapPanel>
        <ListBox x:Name="FilesList" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding GroupLabel}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" /><TextBlock Text="{Binding File}" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    </DockPanel>
</Window>
