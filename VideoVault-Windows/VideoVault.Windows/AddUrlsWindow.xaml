<Window x:Class="VideoVault.Windows.AddUrlsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Downloads"
        Style="{StaticResource {x:Type Window}}"
        Height="420"
        Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Paste one URL per line" FontSize="22" FontWeight="SemiBold" />

        <TextBox x:Name="UrlsTextBox"
                 Grid.Row="1"
                 Margin="0,16,0,16"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 TextWrapping="Wrap" AutomationProperties.Name="Video URLs" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Format:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="FormatComboBox" Width="280" DisplayMemberPath="Name" SelectedValuePath="Format" />
        </StackPanel>

        <DockPanel Grid.Row="3" Margin="0,20,0,0">
            <Button Content="Cancel" DockPanel.Dock="Right" Click="Cancel_Click" />
            <Button Content="Add To Queue" DockPanel.Dock="Right" Click="Add_Click" />
        </DockPanel>
    </Grid>
</Window>
